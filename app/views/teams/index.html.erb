<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Teams</h1>
  <%= link_to "New Team", new_team_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @teams.each do |team| %>
    <%= link_to team_path(team), class: "bg-white rounded-lg shadow p-6 hover:shadow-md transition" do %>
      <h2 class="text-lg font-semibold text-gray-900"><%= team.name %></h2>
      <p class="text-gray-600 text-sm mt-1"><%= team.description&.truncate(100) %></p>
      <div class="flex gap-4 mt-4 text-sm text-gray-500">
        <span><%= team.projects.count %> projects</span>
        <span><%= team.users.count %> members</span>
      </div>
    <% end %>
  <% end %>
</div>
