<%= link_to "← Back to teams", teams_path, class: "text-cyan-400 hover:underline mb-4 inline-block" %>

<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-100"><%= @team.name %></h1>
  <div class="flex gap-2">
    <%= link_to "New Project", new_team_project_path(@team), class: "bg-cyan-600 text-white px-4 py-2 rounded-lg hover:bg-cyan-700" %>
    <%= link_to "Edit", edit_team_path(@team), class: "bg-gray-700 text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-600" %>
  </div>
</div>

<p class="text-gray-400 mb-6"><%= @team.description %></p>

<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
  <div class="md:col-span-2">
    <h2 class="text-lg font-semibold text-gray-100 mb-4">Projects</h2>
    <% if @projects.any? %>
      <div class="space-y-3">
        <% @projects.each do |project| %>
          <%= link_to project_path(project), class: "block bg-gray-800 border border-gray-700 rounded-lg p-4 hover:border-cyan-500 transition" do %>
            <div class="flex justify-between items-start">
              <div>
                <h3 class="font-semibold text-gray-100"><%= project.name %></h3>
                <p class="text-sm text-gray-400"><%= project.tasks.count %> tasks</p>
              </div>
              <span class="px-2 py-1 text-xs rounded <%= project.status == 'completed' ? 'bg-green-900/50 text-green-300 border border-green-700' : project.status == 'in_progress' ? 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' : 'bg-gray-700 text-gray-300 border border-gray-600' %>">
                <%= project.status.humanize %>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-400">No projects yet.</p>
    <% end %>
  </div>

  <div>
    <h2 class="text-lg font-semibold text-gray-100 mb-4">Members</h2>
    <div class="space-y-2">
      <% @members.each do |member| %>
        <div class="bg-gray-800 border border-gray-700 rounded-lg p-3 flex justify-between items-center">
          <span class="text-sm text-gray-100"><%= member.email %></span>
          <span class="text-xs text-gray-400"><%= member.role_on(@team) %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>
