<%= tag.div id: dom_id(task), class: "bg-gray-800 border border-gray-700 rounded-lg p-4 hover:border-cyan-500 transition" do %>
  <%= link_to task_path(task), class: "block" do %>
    <div class="flex justify-between items-start">
      <div>
        <h3 class="font-semibold text-gray-100"><%= task.title %></h3>
        <p class="text-sm text-gray-400"><%= task.user&.email || "Unassigned" %></p>
      </div>
      <div class="flex gap-2 items-center">
        <span class="px-2 py-1 text-xs rounded <%= case task.priority when 'urgent' then 'bg-red-900/50 text-red-300 border border-red-700' when 'high' then 'bg-orange-900/50 text-orange-300 border border-orange-700' when 'medium' then 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' else 'bg-gray-700 text-gray-300 border border-gray-600' end %>">
          <%= task.priority %>
        </span>
        <span class="px-2 py-1 text-xs rounded <%= task.status == 'done' ? 'bg-green-900/50 text-green-300 border border-green-700' : task.status == 'in_progress' ? 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' : 'bg-gray-700 text-gray-300 border border-gray-600' %>">
          <%= task.status.humanize %>
        </span>
      </div>
    </div>
  <% end %>
<% end %>
