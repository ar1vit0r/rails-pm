<%= tag.div id: dom_id(task), class: "bg-white rounded-lg shadow p-4 hover:shadow-md transition" do %>
  <%= link_to task_path(task), class: "block" do %>
    <div class="flex justify-between items-start">
      <div>
        <h3 class="font-semibold text-gray-900"><%= task.title %></h3>
        <p class="text-sm text-gray-500"><%= task.user&.email || "Unassigned" %></p>
      </div>
      <div class="flex gap-2 items-center">
        <span class="px-2 py-1 text-xs rounded <%= case task.priority when 'urgent' then 'bg-red-100 text-red-800' when 'high' then 'bg-orange-100 text-orange-800' when 'medium' then 'bg-yellow-100 text-yellow-800' else 'bg-gray-100 text-gray-800' end %>">
          <%= task.priority %>
        </span>
        <span class="px-2 py-1 text-xs rounded <%= task.status == 'done' ? 'bg-green-100 text-green-800' : task.status == 'in_progress' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800' %>">
          <%= task.status.humanize %>
        </span>
      </div>
    </div>
  <% end %>
<% end %>
