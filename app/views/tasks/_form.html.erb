<div class="bg-gray-800 border border-gray-700 rounded-lg p-6 max-w-lg">
  <%= form_with model: @task, url: (@task.persisted? ? task_path(@task) : project_tasks_path(@project)), class: "space-y-4" do |f| %>
    <% if @task.errors.any? %>
      <div class="bg-red-900/50 text-red-300 border border-red-700 px-4 py-2 rounded">
        <% @task.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :title, class: "block text-sm font-medium text-gray-300" %>
      <%= f.text_field :title, class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100" %>
    </div>
    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-300" %>
      <%= f.text_area :description, rows: 3, class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100" %>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :status, class: "block text-sm font-medium text-gray-300" %>
        <%= f.select :status, Task.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100" %>
      </div>
      <div>
        <%= f.label :priority, class: "block text-sm font-medium text-gray-300" %>
        <%= f.select :priority, Task.priorities.keys.map { |p| [p.humanize, p] }, {}, class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100" %>
      </div>
    </div>
    <div>
      <%= f.label :due_date, class: "block text-sm font-medium text-gray-300" %>
      <%= f.date_field :due_date, class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100" %>
    </div>
    <div class="flex gap-2">
      <%= f.submit (@task.persisted? ? "Save changes" : "Create task"), class: "bg-cyan-600 text-white px-6 py-2 rounded-lg hover:bg-cyan-700 cursor-pointer" %>
      <%= link_to "Cancel", (@task.persisted? ? task_path(@task) : project_path(@project)), class: "bg-gray-700 text-gray-300 px-6 py-2 rounded-lg hover:bg-gray-600" %>
    </div>
  <% end %>
</div>
