<%= link_to "← Back to #{@task.project.name}", project_path(@task.project), class: "text-indigo-600 hover:underline mb-4 inline-block" %>

<div class="bg-white rounded-lg shadow p-6 mb-6">
  <div class="flex justify-between items-start mb-4">
    <h1 class="text-2xl font-bold text-gray-900"><%= @task.title %></h1>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_task_path(@task), class: "bg-gray-200 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-300" %>
      <%= button_to "Delete", task_path(@task), method: :delete, class: "bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <p class="text-gray-700 mb-4"><%= @task.description %></p>

  <div class="flex gap-4 text-sm">
    <span class="px-3 py-1 rounded <%= @task.status == 'done' ? 'bg-green-100 text-green-800' : @task.status == 'in_progress' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800' %>">
      <%= @task.status.humanize %>
    </span>
    <span class="px-3 py-1 rounded <%= case @task.priority when 'urgent' then 'bg-red-100 text-red-800' when 'high' then 'bg-orange-100 text-orange-800' when 'medium' then 'bg-yellow-100 text-yellow-800' else 'bg-gray-100 text-gray-800' end %>">
      <%= @task.priority %>
    </span>
    <% if @task.due_date.present? %>
      <span class="text-gray-500">Due: <%= @task.due_date.strftime("%b %d, %Y") %></span>
    <% end %>
    <span class="text-gray-500">Assigned to: <%= @task.user&.email || "Unassigned" %></span>
  </div>
</div>

<h2 class="text-lg font-semibold text-gray-900 mb-4">Comments</h2>

<div id="comments" class="space-y-3 mb-6">
  <% @comments.each do |comment| %>
    <div class="bg-white rounded-lg shadow p-4">
      <div class="flex justify-between items-start mb-2">
        <span class="font-medium text-gray-900"><%= comment.user.email %></span>
        <span class="text-xs text-gray-500"><%= comment.created_at.strftime("%b %d, %Y %H:%M") %></span>
      </div>
      <p class="text-gray-700"><%= comment.body %></p>
    </div>
  <% end %>
</div>

<%= form_with model: @comment, url: task_comments_path(@task), class: "bg-white rounded-lg shadow p-4" do |f| %>
  <div class="mb-3">
    <%= f.text_area :body, rows: 3, placeholder: "Add a comment...", class: "border rounded-lg px-4 py-2 w-full" %>
  </div>
  <%= f.submit "Add Comment", class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 cursor-pointer" %>
<% end %>
