<%= link_to "← Back to #{@task.project.name}", project_path(@task.project), class: "text-cyan-400 hover:underline mb-4 inline-block" %>

<div class="bg-gray-800 border border-gray-700 rounded-lg p-6 mb-6">
  <div class="flex justify-between items-start mb-4">
    <h1 class="text-2xl font-bold text-gray-100"><%= @task.title %></h1>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_task_path(@task), class: "bg-gray-700 text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-600" %>
      <%= button_to "Delete", task_path(@task), method: :delete, class: "bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <p class="text-gray-300 mb-4"><%= @task.description %></p>

  <div class="flex gap-4 text-sm">
    <span class="px-3 py-1 rounded <%= @task.status == 'done' ? 'bg-green-900/50 text-green-300 border border-green-700' : @task.status == 'in_progress' ? 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' : 'bg-gray-700 text-gray-300 border border-gray-600' %>">
      <%= @task.status.humanize %>
    </span>
    <span class="px-3 py-1 rounded <%= case @task.priority when 'urgent' then 'bg-red-900/50 text-red-300 border border-red-700' when 'high' then 'bg-orange-900/50 text-orange-300 border border-orange-700' when 'medium' then 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' else 'bg-gray-700 text-gray-300 border border-gray-600' end %>">
      <%= @task.priority %>
    </span>
    <% if @task.due_date.present? %>
      <span class="text-gray-400">Due: <%= @task.due_date.strftime("%b %d, %Y") %></span>
    <% end %>
    <span class="text-gray-400">Assigned to: <%= @task.user&.email || "Unassigned" %></span>
  </div>
</div>

<h2 class="text-lg font-semibold text-gray-100 mb-4">Comments</h2>

<div id="comments" class="space-y-3 mb-6">
  <% @comments.each do |comment| %>
    <div class="bg-gray-800 border border-gray-700 rounded-lg p-4">
      <div class="flex justify-between items-start mb-2">
        <span class="font-medium text-gray-100"><%= comment.user.email %></span>
        <span class="text-xs text-gray-400"><%= comment.created_at.strftime("%b %d, %Y %H:%M") %></span>
      </div>
      <p class="text-gray-300"><%= comment.body %></p>
    </div>
  <% end %>
</div>

<%= form_with model: @comment, url: task_comments_path(@task), class: "bg-gray-800 border border-gray-700 rounded-lg p-4" do |f| %>
  <div class="mb-3">
    <%= f.text_area :body, rows: 3, placeholder: "Add a comment...", class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100" %>
  </div>
  <%= f.submit "Add Comment", class: "bg-cyan-600 text-white px-4 py-2 rounded-lg hover:bg-cyan-700 cursor-pointer" %>
<% end %>
