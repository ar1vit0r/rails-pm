<div class="bg-gray-800 border border-gray-700 rounded-lg p-6 max-w-lg">
  <%= form_with model: @project, url: (@project.persisted? ? project_path(@project) : team_projects_path(@team)), class: "space-y-4" do |f| %>
    <% if @project.errors.any? %>
      <div class="bg-red-900/50 text-red-300 border border-red-700 px-4 py-2 rounded">
        <% @project.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-300" %>
      <%= f.text_field :name, class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100" %>
    </div>
    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-300" %>
      <%= f.text_area :description, rows: 3, class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100" %>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :status, class: "block text-sm font-medium text-gray-300" %>
        <%= f.select :status, Project.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100" %>
      </div>
      <div>
        <%= f.label :deadline, class: "block text-sm font-medium text-gray-300" %>
        <%= f.date_field :deadline, class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100" %>
      </div>
    </div>
    <div class="flex gap-2">
      <%= f.submit (@project.persisted? ? "Save changes" : "Create project"), class: "bg-cyan-600 text-white px-6 py-2 rounded-lg hover:bg-cyan-700 cursor-pointer" %>
      <%= link_to "Cancel", (@project.persisted? ? project_path(@project) : team_path(@team)), class: "bg-gray-700 text-gray-300 px-6 py-2 rounded-lg hover:bg-gray-600" %>
    </div>
  <% end %>
</div>
