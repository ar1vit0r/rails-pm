<% if user_signed_in? %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-x-12 gap-y-10">
    <section class="lg:col-span-2" aria-labelledby="recent-tasks">
      <h1 id="recent-tasks" class="text-3xl font-semibold tracking-tight text-gray-100">Recent tasks</h1>
      <p class="mt-1 mb-6 text-gray-400">Assigned to you, latest activity first.</p>

      <% if @recent_tasks.any? %>
        <ul class="divide-y divide-gray-800 border-y border-gray-800">
          <% @recent_tasks.each do |task| %>
            <% priority = priority_style(task) %>
            <% status = status_style(task) %>
            <li>
              <%= link_to task_path(task), class: "flex items-stretch gap-4 py-4 pr-3 hover:bg-gray-800/60 motion-safe:transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-cyan-400" do %>
                <span class="w-1 shrink-0 rounded-full <%= priority[:edge] %>" aria-hidden="true"></span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-base font-medium <%= task.done? ? 'text-gray-400' : 'text-gray-100' %>"><%= task.title %></span>
                  <span class="block truncate text-sm text-gray-400"><%= task.project.name %></span>
                </span>
                <span class="shrink-0 text-right whitespace-nowrap">
                  <span class="block text-sm <%= status[:text] %>"><span aria-hidden="true"><%= status[:glyph] %></span> <%= task.status.to_s.humanize %></span>
                  <span class="block text-xs <%= priority[:text] %>"><%= task.priority.to_s.humanize %> priority</span>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-400">No tasks are assigned to you yet.</p>
      <% end %>
    </section>

    <section aria-labelledby="teams-heading">
      <div class="flex items-baseline justify-between mb-4">
        <h2 id="teams-heading" class="text-lg font-semibold text-gray-100">Teams</h2>
        <%= link_to "New team", new_team_path, class: "text-sm text-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-cyan-400" %>
      </div>

      <% if @teams.any? %>
        <ul class="space-y-2">
          <% @teams.each do |team| %>
            <li>
              <%= link_to team_path(team), class: "block rounded-lg border border-gray-700 bg-gray-800 px-4 py-3 hover:border-cyan-500 motion-safe:transition-colors focus-visible:outline-2 focus-visible:outline-cyan-400" do %>
                <span class="block font-medium text-gray-100"><%= team.name %></span>
                <span class="mt-0.5 flex gap-4 text-sm text-gray-400">
                  <span><%= pluralize(team.projects.size, "project") %></span>
                  <span><%= pluralize(team.users.size, "member") %></span>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-400">No teams yet.
          <%= link_to "Create your first team", new_team_path, class: "text-cyan-400 hover:text-cyan-300 underline" %>
          to start organizing projects.</p>
      <% end %>
    </section>
  </div>
<% else %>
  <div class="text-center py-16">
    <h1 class="text-4xl font-bold text-gray-100 mb-4">Project Manager</h1>
    <p class="text-xl text-gray-400 mb-8">Organize your teams, projects, and tasks in real-time.</p>
    <div class="flex justify-center gap-4">
      <%= link_to "Sign up", new_user_registration_path, class: "bg-cyan-600 text-white px-8 py-3 rounded-lg hover:bg-cyan-700 text-lg" %>
      <%= link_to "Login", new_user_session_path, class: "bg-gray-800 text-gray-300 px-8 py-3 rounded-lg hover:bg-gray-700 text-lg border border-gray-700" %>
    </div>
  </div>
<% end %>
